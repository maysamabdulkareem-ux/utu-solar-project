# Copy to your own environment (do not commit real values).

# Required: at least 32 random characters.
JWT_SECRET_KEY=
JWT_ISSUER=utu-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: defaults to sqlite:///./solar.db
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API.
UTU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password for demo accounts created by seed.py (demo databases only).
UTU_DEMO_PASSWORD=

# Legacy admin header token. Planned for removal in merge Phase 2.
UTU_ADMIN_TOKEN=

# Company password-reset email (optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PUBLIC_APP_URL=http://127.0.0.1:5173
